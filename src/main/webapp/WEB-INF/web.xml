<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	version="4.0">

	<display-name>antmillion-ui-only</display-name>

	<!-- Welcome -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- Home -->
	<servlet>
		<servlet-name>HomeServlet</servlet-name>
		<servlet-class>com.antmillion.web.HomeServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>HomeServlet</servlet-name>
		<url-pattern>/</url-pattern>
	</servlet-mapping>

	<!-- Login -->
	<servlet>
		<servlet-name>LoginServlet</servlet-name>
		<servlet-class>com.antmillion.web.LoginServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>LoginServlet</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>

	<!-- Signup -->
	<servlet>
		<servlet-name>SignupServlet</servlet-name>
		<servlet-class>com.antmillion.web.SignupServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>SignupServlet</servlet-name>
		<url-pattern>/signup</url-pattern>
	</servlet-mapping>

	<!-- Step2 -->
	<servlet>
		<servlet-name>SignupStep2Servlet</servlet-name>
		<servlet-class>com.antmillion.web.SignupStep2Servlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>SignupStep2Servlet</servlet-name>
		<url-pattern>/signup/step2</url-pattern>
	</servlet-mapping>

	<!-- Complete -->
	<servlet>
		<servlet-name>SignupCompleteServlet</servlet-name>
		<servlet-class>com.antmillion.web.SignupCompleteServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>SignupCompleteServlet</servlet-name>
		<url-pattern>/signup/complete</url-pattern>
	</servlet-mapping>

	<!-- Static resources: let Tomcat default servlet serve them -->
	<servlet-mapping>
		<servlet-name>default</servlet-name>
		<url-pattern>/resources/*</url-pattern>
	</servlet-mapping>

</web-app>
