<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.antmillion.mappers.CommunityMapper">

    <!-- ResultMap 정의 -->
    <resultMap id="CommunityDetailResponseMap" type="com.antmillion.communication.dto.CommunityDetailResponseDTO">
        <id property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="nickname" column="nickname"/>
        <result property="stockCode" column="stock_code"/>
        <result property="stockName" column="stock_name"/>
        <result property="content" column="content"/>
        <result property="postedDate" column="posted_date"/>
    </resultMap>

    <!-- 특정 종목의 커뮤니티 글 목록 조회-->
    <select id="selectCommunityListByStock" resultMap="CommunityDetailResponseMap">
        SELECT 
            c.post_id,
            c.user_id,
            m.nickname,
            c.stock_code,
            s.stock_name,
            c.content,
            c.posted_date
        FROM community c
        INNER JOIN member m ON c.user_id = m.user_id
        LEFT JOIN stock s ON c.stock_code = s.stock_code
        WHERE c.stock_code = #{stockCode}
        ORDER BY c.posted_date DESC
    </select>

    <!-- 커뮤니티 글 등록 -->
    <insert id="insertCommunity" parameterType="com.antmillion.communication.dto.CommunityDTO">
        INSERT INTO community (
            post_id,
            user_id,
            stock_code,
            content,
            posted_date
        ) VALUES (
            #{postId},
            #{userId},
            #{stockCode},
            #{content},
            NOW()
        )
    </insert>

</mapper>