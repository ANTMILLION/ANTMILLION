<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antmillion.mappers.MissionMapper">

    <resultMap id="quizDetailMap" type="com.antmillion.mission.dto.QuizQuestionDTO">
        <id property="quizId" column="quiz_id"/>
        <result property="missionId" column="mission_id"/>
        <result property="type" column="type"/>
        <result property="question" column="question"/>
        <result property="answer" column="answer"/>
        <result property="explanation" column="explanation"/>
        <result property="point" column="point"/>
        <result property="quizDate" column="quiz_date"/>

        <collection property="choices" ofType="com.antmillion.mission.dto.QuizChoiceDTO">
            <id property="quizChoiceId" column="quiz_choice_id"/>
            <result property="quizId" column="c_quiz_id"/>
            <result property="choiceNo" column="choice_no"/>
            <result property="choiceText" column="choice_text"/>
        </collection>
    </resultMap>

    <select id="selectQuizByDate" resultMap="quizDetailMap">
        SELECT
            q.quiz_id,
            q.mission_id,
            q.type,
            q.question,
            q.answer,
            q.explanation,
            q.point,
            q.quiz_date,
            c.quiz_choice_id,
            c.quiz_id AS c_quiz_id,
            c.choice_no,
            c.choice_text
        FROM quiz_question q
        LEFT JOIN quiz_choice c ON q.quiz_id = c.quiz_id
        WHERE DATE_FORMAT(q.quiz_date, '%Y-%m-%d') = #{quizDate}
        ORDER BY q.quiz_id ASC, c.choice_no ASC
    </select>

    <insert id="insertQuizLog" parameterType="com.antmillion.mission.dto.QuizLogDTO">
        INSERT INTO quiz_log (user_id, quiz_id, solved_at)
        VALUES (#{userId}, #{quizId}, NOW())
    </insert>

    <select id="countSolvedHistory" resultType="int">
        SELECT COUNT(*)
        FROM quiz_log
        WHERE user_id = #{userId} AND quiz_id = #{quizId}
    </select>

    <select id="countTodaySolved" resultType="int">
        SELECT COUNT(*)
        FROM quiz_log
        WHERE user_id = #{userId}
        AND DATE_FORMAT(solved_at, '%Y-%m-%d') = CURDATE()
    </select>
</mapper>