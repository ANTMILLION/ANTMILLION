<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antmillion.user.mapper.AntRankMapper">
    <resultMap id="antRankMap" type="com.antmillion.user.dto.AntRankDTO">
        <id property="rankId" column="rank_id"/>
        <result property="rankType" column="rank_type"/>
        <result property="requiredPoint" column="required_point"/>
        <result property="rankImage" column="rank_image"/>
    </resultMap>

    <select id="selectAllRanks" resultMap="antRankMap">
        SELECT rank_id, rank_type, required_point, rank_image
        FROM ant_rank
        ORDER BY required_point ASC
    </select>
</mapper>