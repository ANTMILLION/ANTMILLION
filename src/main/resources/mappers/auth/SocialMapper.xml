<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.antmillion.auth.mapper.SocialMapper">

  <select id="selectUserIdByKakaoId" resultType="long">
    SELECT user_id
    FROM social
    WHERE kakao_id = #{kakaoId}
    LIMIT 1
  </select>

  <insert id="insertSocial">
    INSERT INTO social (kakao_id, user_id)
    VALUES (#{kakaoId}, #{userId})
  </insert>

</mapper>
