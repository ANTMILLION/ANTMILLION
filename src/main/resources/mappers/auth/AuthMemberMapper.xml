<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.antmillion.auth.mapper.AuthMemberMapper">

	<select id="selectByEmail" parameterType="string"
		resultType="com.antmillion.auth.dto.AuthMemberDTO">
		SELECT
		user_id AS userId,
		email,
		password,
		rank_id AS rankId,
		provider AS provider
		FROM member
		WHERE email = #{email}
		LIMIT 1
	</select>

</mapper>