<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.antmillion.mappers.KisAccessTokenMapper">

    <resultMap id="KisAccessTokenMap" type="com.antmillion.kis.dto.KisAccessToken">
        <id property="id" column="id"/>
        <result property="token" column="token"/>
        <result property="expiresAt" column="expires_at"/>
    </resultMap>

    <!-- 저장 (ID는 AUTO_INCREMENT) -->
    <insert id="save" parameterType="com.antmillion.kis.dto.KisAccessToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kis_access_token (
            token,
            expires_at
        ) VALUES (
                     #{token},
                     #{expiresAt}
                 )
    </insert>

    <select id="findLatestAccessToken" resultMap="KisAccessTokenMap">
        SELECT *
        FROM kis_access_token
        ORDER BY id DESC
            LIMIT 1
    </select>

</mapper>
